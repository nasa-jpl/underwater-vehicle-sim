<launch>
 <rosparam param="underwater_vehicle_sim/hertz">100</rosparam>
 <rosparam param="vehicles/names">[v2,v3]</rosparam>

 <rosparam param="vehicles/v2/start_x">0</rosparam>
 <rosparam param="vehicles/v2/start_y">0</rosparam>
 <rosparam param="vehicles/v2/start_z">-100</rosparam> 
 <rosparam param="vehicles/v2/moduleNames">[dataBroadcaster]</rosparam>
 <rosparam param="vehicles/v2/dataBroadcaster/type">DataBroadcaster</rosparam>
 <rosparam param="vehicles/v2/dataBroadcaster/hertz">10</rosparam>
 <rosparam param="vehicles/v2/propModuleName">prop_v2</rosparam>
 <rosparam param="vehicles/v2/prop_v2/type">FourDOFPropulsion</rosparam>
 <rosparam param="vehicles/v2/prop_v2/hertz">10</rosparam>

 <rosparam param="vehicles/v3/start_x">100</rosparam>
 <rosparam param="vehicles/v3/start_y">100</rosparam>
 <rosparam param="vehicles/v3/start_z">-100</rosparam> 
 <rosparam param="vehicles/v3/moduleNames">[dataBroadcaster]</rosparam>
 <rosparam param="vehicles/v3/dataBroadcaster/type">DataBroadcaster</rosparam>
 <rosparam param="vehicles/v3/dataBroadcaster/hertz">10</rosparam>
 <rosparam param="vehicles/v3/propModuleName">prop_v3</rosparam>
 <rosparam param="vehicles/v3/prop_v3/type">FourDOFPropulsion</rosparam>
 <rosparam param="vehicles/v3/prop_v3/hertz">10</rosparam>

 <rosparam param="model_type">linear</rosparam>
 <rosparam param="model/u">0.5</rosparam>
 <rosparam param="model/v">0.5</rosparam>
 <rosparam param="model/temp">0.5</rosparam>
 <rosparam param="model/salt">0.5</rosparam>
 <rosparam param="model/dye">0.5</rosparam>
 <rosparam param="model/depth">300</rosparam>
 <rosparam param="model/zeroDistance">50</rosparam>
 <rosparam param="model/type">square</rosparam>

 <rosparam param="vehicle_controller/hertz">2</rosparam>

 <param name="use_sim_time" value="true" />
 <rosparam param="speed_up_factor">20</rosparam>
 <rosparam param="sim_start_time">0</rosparam>

 <node pkg="underwater_vehicle_sim" type="clock_server_node" name="clock_server" output="screen" />

 <node pkg="underwater_vehicle_sim" type="underwater_vehicle_sim_node" name="underwater_vehicle_sim" output="screen" />
 <node pkg="vehicle_auto_control" type="vehicle_auto_control_node" name="vehicle_auto_control" output="screen"/>

 <node pkg="model_server" type="model_server_node" name="model_server" output="screen"/>
 <node pkg="data_server" type="data_server_node" name="data_server" output="screen" />

 <node pkg="plume_detector" type="plume_detector_node" name="plume_detector" output="screen"/>

 <test test-name="four_dof_propulsion_controller_test" pkg="vehicle_auto_control" type="dynamic_lawnmower_test" />
</launch>
