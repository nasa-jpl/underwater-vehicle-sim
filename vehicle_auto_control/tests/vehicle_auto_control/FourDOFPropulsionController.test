<launch>
 <rosparam param="vehicles/names">[v0,v1]</rosparam>


 <rosparam param="vehicles/v0/start_x">0</rosparam>
 <rosparam param="vehicles/v0/start_y">0</rosparam>
 <rosparam param="vehicles/v0/start_z">-100</rosparam>

 <rosparam param="vehicles/v0/propModuleName">prop</rosparam>
 <rosparam param="vehicles/v0/prop/type">FourDOFPropulsion</rosparam>
 <rosparam param="vehicles/v0/prop/hertz">10</rosparam>

 <rosparam param="vehicles/v1/start_x">0</rosparam>
 <rosparam param="vehicles/v1/start_y">0</rosparam>
 <rosparam param="vehicles/v1/start_z">-100</rosparam>

 <rosparam param="vehicles/v1/propModuleName">prop</rosparam>
 <rosparam param="vehicles/v1/prop/type">FourDOFPropulsion</rosparam>
 <rosparam param="vehicles/v1/prop/hertz">10</rosparam>

 <rosparam param="vehicle_controller/hertz">5</rosparam>

 <param name="use_sim_time" value="true" />
 <rosparam param="speed_up_factor">20</rosparam>
 <rosparam param="sim_start_time">0</rosparam>

 <node pkg="underwater_vehicle_sim" type="clock_server_node" name="clock_server" output="screen" />

 <node pkg="underwater_vehicle_sim" type="underwater_vehicle_sim_node" name="underwater_vehicle_sim" output="screen" />
 <node pkg="vehicle_auto_control" type="vehicle_auto_control_node" name="vehicle_auto_control" output="screen"/>
 <test test-name="four_dof_propulsion_controller_test" pkg="vehicle_auto_control" type="four_dof_propulsion_controller_test" />
</launch>
