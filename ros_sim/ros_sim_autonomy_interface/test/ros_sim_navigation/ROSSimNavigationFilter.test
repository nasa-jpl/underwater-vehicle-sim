<launch>
 <rosparam param="navigation/hertz">10</rosparam>
 <rosparam param="navigation/filter/names-">[v1_true]</rosparam>

 <rosparam param="navigation/filter/v1_true/type">TrueNavigation</rosparam>
 <rosparam param="navigation/filter/v1_true/vehicle_name">v1</rosparam>
 <test test-name="ros_sim_navigation_filter_test" pkg="ros_sim_autonomy_interface" type="ros_sim_navigation_filter_test"/>
</launch>