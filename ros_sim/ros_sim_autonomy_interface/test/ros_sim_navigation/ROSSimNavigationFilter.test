<launch>
 
 <test test-name="ros_sim_navigation_filter_test" pkg="ros_sim_autonomy_interface" type="ros_sim_navigation_filter_test" ns="v1">
    <rosparam param="hertz">10</rosparam>
    <rosparam param="filter/names-">[true_nav]</rosparam>

    <rosparam param="filter/true_nav/type">TrueNavigation</rosparam>
 </test>
</launch>