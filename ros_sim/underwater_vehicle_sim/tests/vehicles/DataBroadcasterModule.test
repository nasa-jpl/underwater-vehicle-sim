<launch>
 <rosparam param="model_type">linear</rosparam>
 <rosparam param="model/centerX">0</rosparam>
 <rosparam param="model/centerY">0</rosparam>
 <rosparam param="model/centerZ">0</rosparam>
 <rosparam param="model/zeroDistance">200</rosparam>
 <rosparam param="model/type">circle</rosparam>

 <rosparam param="model/u">10</rosparam>
 <rosparam param="model/v">15</rosparam>
 <rosparam param="model/temp">20</rosparam>
 <rosparam param="model/salt">25</rosparam>
 <rosparam param="model/dye">30</rosparam>
 <rosparam param="model/depth">200</rosparam>

 <node pkg="model_server" type="model_server_node" name="model_server" output="screen"/>
 <test test-name="data_broadcaster_module_test" pkg="underwater_vehicle_sim" type="data_broadcaster_module_test"/>
</launch>
