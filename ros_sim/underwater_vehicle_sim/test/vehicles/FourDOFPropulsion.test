<launch>
    <test test-name="four_dof_propulsion_test" pkg="underwater_vehicle_sim"  ns="v1" type="four_dof_propulsion_test">
        <rosparam param="forward_thruster_thrust">[-100,0,100]</rosparam>
        <rosparam param="forward_thruster_velocity">[-1,0,2]</rosparam>

        <rosparam param="lateral_thruster_thrust">[-100,0,100]</rosparam>
        <rosparam param="lateral_thruster_velocity">[-1,0,1]</rosparam>

        <rosparam param="vertical_thruster_thrust">[-100,0,100]</rosparam>
        <rosparam param="vertical_thruster_velocity">[-1,0,1]</rosparam>

        <rosparam param="rudder_angle">[-45,0,45]</rosparam>
        <rosparam param="rudder_velocity">[-5,0,5]</rosparam>
    </test>
</launch>
