<launch>
 <rosparam param="vehicles/names">[v1]</rosparam>

 <rosparam param="vehicles/v1/start_x">300</rosparam>
 <rosparam param="vehicles/v1/start_y">0</rosparam>
 <rosparam param="vehicles/v1/start_z">0</rosparam>


 <rosparam param="vehicles/v1/propModuleName">prop_v1</rosparam>
 <rosparam param="vehicles/v1/prop_v1/type">FourDOFPropulsion</rosparam>
 <rosparam param="vehicles/v1/moduleNames">[data_recorder]</rosparam>
 <rosparam param="vehicles/v1/data_recorder/type">DataRecorder</rosparam>
 <rosparam param="vehicles/v1/data_recorder/hertz">1</rosparam>

 <param name="use_sim_time" value="true" />
 <rosparam param="speed_up_factor">1</rosparam>
 <rosparam param="sim_start_time">1728000</rosparam>

 <rosparam param="model_type">fvcom</rosparam>
 <rosparam param="model/fvcom_directory" subst_value="True">/home/branch/proj/ocean_worlds/models/axial_output</rosparam>
 
 <node pkg="model_server" type="model_server_node" name="model_server" output="screen"/>
 <node pkg="underwater_vehicle_sim" type="clock_server_node" name="clock_server"/>
 <node pkg="underwater_vehicle_sim" type="underwater_vehicle_sim_node" name="underwater_vehicle_sim" output="screen"/>
 <node pkg="data_server" type="data_server_node" name="data_server"/>
</launch>
