<launch>
 <rosparam param="underwater_vehicle_sim/hertz">100</rosparam>
 <rosparam param="vehicles/names">[v1,v2,v3]</rosparam>

 <rosparam param="vehicles/v1/start_x">-100</rosparam>
 <rosparam param="vehicles/v1/start_y">100</rosparam>
 <rosparam param="vehicles/v1/start_z">-100</rosparam>

 <rosparam param="vehicles/v2/start_x">521.25</rosparam>
 <rosparam param="vehicles/v2/start_y">-434.5</rosparam>
 <rosparam param="vehicles/v2/start_z">0</rosparam>

 <rosparam param="vehicles/v3/start_x">200</rosparam>
 <rosparam param="vehicles/v3/start_y">-100</rosparam>
 <rosparam param="vehicles/v3/start_z">-234</rosparam>

 <node pkg="underwater_vehicle_sim" type="underwater_vehicle_sim_node" name="underwater_vehicle_sim" output="screen" />
 <test test-name="init_underwater_vehicle_sim_test" pkg="underwater_vehicle_sim" type="init_underwater_vehicle_sim_test" />
</launch>
