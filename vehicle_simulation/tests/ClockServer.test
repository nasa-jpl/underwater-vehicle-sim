<launch>
 <param name="use_sim_time" value="true" />
 <rosparam param="speed_up_factor">5</rosparam>
 <rosparam param="sim_start_time">1000</rosparam>
 <node pkg="vehicle_simulation" type="clock_server_node" name="clock_server" output="screen" />
 <test test-name="clock_server_test" pkg="vehicle_simulation" type="clock_server_test" />
</launch>
