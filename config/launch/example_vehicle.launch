<launch>
    <!--This argument allows disabling of rosbag recording if that is not needed.-->
    <arg name="record_rosbag" default="true" />

    <!-- Set the primary navigation source for all vehicles to be true_nav/pose from underwater_vehicle_sim_true_navigation_node
         See https://wiki.ros.org/Remapping%20Arguments to better understand remap argument meaning. If different vehicles need
         different navigation sources then the vehicle namespace should be specified or this should be moved to the underwater_vehicle_sim_node
         <node> definition.
    -->
    <remap from="primary_navigation" to="true_nav/pose" />

    <!--This defines the vehicle and the different modules that vehicle has-->
    <node pkg="underwater_vehicle_sim" type="underwater_vehicle_sim_node" name="vehicle_sim" ns="v1" output="screen">
        <rosparam param="sim_hertz">10</rosparam>
        <rosparam param="start_x">0</rosparam>
        <rosparam param="start_y">0</rosparam>

        <rosparam param="start_z">0</rosparam>
        <rosparam param="evect_by_currents">false</rosparam>
        <rosparam param="local_model">true</rosparam>

        <!--This defines the propulsion system and provides a mapping of requested thrust to actual velocity as a piecewise linear function
            for forward/backward, lateral, and rotation-->
        <rosparam param="propulsion_type">FourDOFPropulsion</rosparam>
        <rosparam param="thrust_sensor_random_noise">2</rosparam>
        <rosparam param="rudder_sensor_random_noise">0.0872665</rosparam>
        <rosparam param="propulsion_hertz">10</rosparam>
        <rosparam param="forward_thruster_thrust">[-100, -75, -50, -25, 0, 25, 50, 75, 100]</rosparam>
        <rosparam param="forward_thruster_velocity">[-1.40625, -1.3125, -1.125, -0.75, 0, 0.75, 1.125, 1.3125, 1.40625]</rosparam>
        <rosparam param="lateral_thruster_thrust">[-100, -75, -50, -25, 0, 25, 50, 75, 100]</rosparam>
        <rosparam param="lateral_thruster_velocity">[-1.40625, -1.3125, -1.125, -0.75, 0, 0.75, 1.125, 1.3125, 1.40625]</rosparam>
        <rosparam param="vertical_thruster_thrust">[-100, -75, -50, -25, 0, 25, 50, 75, 100]</rosparam>
        <rosparam param="vertical_thruster_velocity">[-1.40625, -1.3125, -1.125, -0.75, 0, 0.75, 1.125, 1.3125, 1.40625]</rosparam>
        <rosparam param="rudder_angle">[-45,0,45]</rosparam>
        <rosparam param="rudder_velocity">[-0.349066,0,0.349066]</rosparam>

        <!--Modules can generally be thought of as sensors.
            DataBroadcaster publishes the model data with the true vehicle position,
            IMU publishes angular velocity and heading data
            DVL publishes speed through water and speed over ground
            Depth publishes water depth.
            USBL publisher pings from a simulated usbl beacon.
            
            The DataBroadcaster is primarily used for science data while the others are primarily navigation data.

            When adding a new module a name should be added to moduleNames and parameters for that module should be
            <name>/param. <name>/type is used to define the type of the module.
        -->
        <rosparam param="moduleNames">[data_broadcaster, imu, depth, dvl]</rosparam>
        <rosparam param="data_broadcaster/type">DataBroadcaster</rosparam>
        <rosparam param="data_broadcaster/hertz">2.5</rosparam>

        <rosparam param="imu/type">IMU</rosparam>
        <rosparam param="imu/angular_velocity_random_error">0.00001745329</rosparam>
        <rosparam param="imu/angular_velocity_bias_error">[0,0,0]</rosparam>
        <rosparam param="imu/heading_random_error">0</rosparam>
        <rosparam param="imu/heading_bias_error">0</rosparam>
        <rosparam param="imu/roll_pitch_random_error">0</rosparam>
        <rosparam param="imu/roll_bias_error">0</rosparam>
        <rosparam param="imu/pitch_bias_error">0</rosparam>
        <rosparam param="imu/hertz">2</rosparam>

        <rosparam param="dvl/type">DVL</rosparam>
        <rosparam param="dvl/hertz">2</rosparam>
        <rosparam param="dvl/water_velocity_random_error">0</rosparam>
        <rosparam param="dvl/bottom_velocity_random_error">0</rosparam>

        <rosparam param="depth/type">Depth</rosparam>
        <rosparam param="depth/depth_random_error">1</rosparam>
        <rosparam param="depth/depth_bias_error">0.5</rosparam>
        <rosparam param="depth/hertz">2.5</rosparam>

        <rosparam param="usbl/type">USBL</rosparam>
        <rosparam param="usbl/configuration">inverted</rosparam>
        <rosparam param="usbl/bearing_random_error">0.0872665</rosparam> <!--5 degrees-->
        <rosparam param="usbl/bearing_bias_error">0.0174533</rosparam>   <!--1 degree-->
        <rosparam param="usbl/range_random_error">0.01</rosparam> <!--Percent of range measurment-->
        <rosparam param="usbl/range_bias_error">0</rosparam> <!--Percent of range measurment-->
        <rosparam param="usbl/valid_bearing_distance">300</rosparam>
        <rosparam param="usbl/valid_range_distance">5000</rosparam>
        <rosparam param="usbl/bad_range_probability">0.1</rosparam>
        <rosparam param="usbl/bad_range_error">1</rosparam> <!--Percent of range measurment-->
        <rosparam param="usbl/beacon_x">0</rosparam>
        <rosparam param="usbl/beacon_y">0</rosparam>
        <rosparam param="usbl/beacon_z">10</rosparam>
        <rosparam param="usbl/hertz">0.01666666666</rosparam>
    </node>

    <!--This defines the propulsion controller. Specifically a 4 DOF controller that allows the vehicle to go 
        up/down, left/right, forward/backward, and yaw. Although left/right is not currently used. This can use open loop or closed-loop control.
        With use_pid set to false it uses open-loop control where the thrust is directly determined by the requested velocity based on the other
        provided parameters (e.g. forward_thruster_thrust/forward_thruster_velocity) which define that assumed relationship. These correspond to
        the same parameters in the simulation which define the true relationship between requested thrust value and vehicle velocity. 
        If use_pid=true then closed loop control will be used based on the navigation information provided by the primary_navigation topic.
        The propulsion controller also has automatic seafloor avoidance built in.-->
    <node pkg="propulsion_controller" type="four_dof_propulsion_control_node" name="controller" ns="v1">
        <param name="use_pid" value="false"/>
        <rosparam param="forward_thruster_thrust">[-100, -75, -50, -25, 0, 25, 50, 75, 100]</rosparam>
        <rosparam param="forward_thruster_velocity">[-1.40625, -1.3125, -1.125, -0.75, 0, 0.75, 1.125, 1.3125, 1.40625]</rosparam>
        <rosparam param="vertical_thruster_thrust">[-100, -75, -50, -25, 0, 25, 50, 75, 100]</rosparam>
        <rosparam param="vertical_thruster_velocity">[-1.40625, -1.3125, -1.125, -0.75, 0, 0.75, 1.125, 1.3125, 1.40625]</rosparam>
        <rosparam param="rudder_angle">[-45,0,45]</rosparam>
        <rosparam param="rudder_velocity">[-0.349066,0,0.349066]</rosparam>

        <remap from="get_state" to="get_propulsion_state" />
        <remap from="state" to="prop_state" />

    </node>

    <!--This node provides navigation information to other nodes. This navigation node is perfect 
        in that it just republishes the actual vehicle pose from the simulation
        We also remap the primary_navigation topic to the topic produced by this node (true_nav/pose).
        This informs the other nodes which navigation solution it should use and allows for multiple navigation
        nodes to be running at once. For example to compare different localization techniques.-->
    <node pkg="underwater_vehicle_sim" type="underwater_vehicle_sim_true_navigation_node" name="underwater_vehicle_sim_true_navigation_node" ns="v1">
        <rosparam param="hertz">5</rosparam>
    </node>

    <!--The simulation can use sim time to allow for faster than realtime simulation
        The follow block sets that up.-->
    <param name="use_sim_time" value="true" />
    <rosparam param="speed_up_factor">10</rosparam>
    <rosparam param="sim_start_time">2592000</rosparam>
    <node pkg="underwater_vehicle_sim" type="clock_server_node" name="clock_server" output="screen"/>


    <!--The simulation can incorporate different types of ocean models. Below is an example of a simple 2d linear model.
        some numerical models are also supported.-->
    <rosparam param="model_type">linear</rosparam>
    <rosparam param="model/zeroDistance">3000</rosparam>
    <rosparam param="model/temp">10</rosparam>
    <rosparam param="model/dye">5</rosparam>

    <!--This sets up a static tf transform between enu an ned space.-->
    <node pkg="tf2_ros" type="static_transform_publisher" name="ned_publisher" args="0 0 0 1.57079632679 0 3.14159265359 world world_ned"/>

    <!--This can be used to record the rosbag from the simulation so it can be plotted later. 
        It is automatically saved to the /docker_data directory-->
     <node pkg="rosbag" type="record" name="rosbag_record"
       args='record -o /docker_data/waypoints -e "/v1/(.*)" /rosout'
       if="$(arg record_rosbag)" />   

</launch>