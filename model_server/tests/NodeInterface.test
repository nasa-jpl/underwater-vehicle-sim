<launch>
 <rosparam param="fvcom_directory" subst_value="True">$(find model_server)/test_data/axial_data_test</rosparam>
 <node pkg="model_server" type="model_server_node" name="model_server" output="screen" />
 <test test-name="model_node_interface_test" pkg="model_server" type="model_node_interface_test" />
</launch>
